--========================================================
-- HELPERS
--========================================================

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = 0.12
	s.Parent = parent
	return s
end

local function text(parent, value, size, font)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text = value
	t.TextColor3 = Theme.Text
	t.TextSize = size
	t.Font = font or Enum.Font.Gotham
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.Parent = parent
	return t
end

local function button(parent, value, size, font)
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = Theme.Button
	b.Text = value
	b.TextColor3 = Theme.Text
	b.TextSize = size
	b.Font = font or Enum.Font.GothamMedium
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Parent = parent
	corner(b, 8)
	stroke(b, Theme.Border, 1)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(.12), {
			BackgroundColor3 = Theme.ButtonHover
		}):Play()
	end)

	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(.12), {
			BackgroundColor3 = Theme.Button
		}):Play()
	end)

	return b
end

local function clickSound()
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://12221967"
	s.Volume = 1
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))

	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60

	if hours > 0 then
		return string.format("%02dh %02dm %02ds", hours, minutes, secs)
	end

	return string.format("%02dm %02ds", minutes, secs)
end

