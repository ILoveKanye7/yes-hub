local function corner(obj, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px)
	c.Parent = obj
end

local function outline(obj)
	local s = Instance.new("UIStroke")
	s.Color       = T.BORDER
	s.Thickness   = 1
	s.Transparency = 0.25
	s.Parent      = obj
end

local function mkLabel(parent, str, sz, font)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text              = str
	t.TextColor3        = T.WHITE
	t.TextSize          = sz
	t.Font              = font or Enum.Font.GothamBold
	t.TextXAlignment    = Enum.TextXAlignment.Left
	t.TextYAlignment    = Enum.TextYAlignment.Center
	t.Parent            = parent
	return t
end

local function mkButton(parent, str)
	local b = Instance.new("TextButton")
	b.BackgroundColor3   = T.BUTTON
	b.BorderSizePixel    = 0
	b.Text               = str
	b.TextColor3         = T.WHITE
	b.TextSize           = 12
	b.Font               = Enum.Font.GothamBold
	b.AutoButtonColor    = false
	b.TextXAlignment     = Enum.TextXAlignment.Center
	b.Parent             = parent
	corner(b, 8)
	outline(b)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.HOVER}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.BUTTON}):Play()
	end)
	return b
end

local function playClick()
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://12221967"
	s.Volume  = 1
	s.Parent  = SoundService
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
end

local function fmtTime(secs)
	secs = math.floor(secs)
	local h = math.floor(secs / 3600)
	local m = math.floor((secs % 3600) / 60)
	local s = secs % 60
	if h > 0 then return string.format("%02dh %02dm %02ds", h, m, s) end
	return string.format("%02dm %02ds", m, s)
end

