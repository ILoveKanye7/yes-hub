-- Smart drag/click detection.
-- A click is preserved unless the pointer moves more than the threshold.
local DRAG_THRESHOLD = 6

local mainPressed = false
local mainDragging = false
local mainDragStart
local mainStartPos

main.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	local y = input.Position.Y - main.AbsolutePosition.Y
	if y <= 74 then
		mainPressed = true
		mainDragging = false
		mainDragStart = input.Position
		mainStartPos = main.Position
	end
end)

local launcherPressed = false
local launcherDragging = false
local launcherDidDrag = false
local launcherDragStart
local launcherStartPos

launcher.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	launcherPressed = true
	launcherDragging = false
	launcherDidDrag = false
	launcherDragStart = input.Position
	launcherStartPos = launcher.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

	if mainPressed then
		local delta = input.Position - mainDragStart

		if not mainDragging and delta.Magnitude >= DRAG_THRESHOLD then
			mainDragging = true
		end

		if mainDragging then
			main.Position = UDim2.new(
				mainStartPos.X.Scale,
				mainStartPos.X.Offset + delta.X,
				mainStartPos.Y.Scale,
				mainStartPos.Y.Offset + delta.Y
			)
		end
	end

	if launcherPressed then
		local delta = input.Position - launcherDragStart

		if not launcherDragging and delta.Magnitude >= DRAG_THRESHOLD then
			launcherDragging = true
			launcherDidDrag = true
		end

		if launcherDragging then
			launcher.Position = UDim2.new(
				launcherStartPos.X.Scale,
				launcherStartPos.X.Offset + delta.X,
				launcherStartPos.Y.Scale,
				launcherStartPos.Y.Offset + delta.Y
			)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mainPressed = false
		mainDragging = false

		launcherPressed = false
		launcherDragging = false
	end
end)

-- Open/close
local function toggle()
	if busy then return end
	busy = true
	opened = not opened
	click()

	if opened then
		main.Visible = true
		main.Size = UDim2.fromOffset(0, 0)

		local tween = TweenService:Create(
			main,
			TweenInfo.new(.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Size = UDim2.fromOffset(720, 430)}
		)
		tween:Play()
		tween.Completed:Wait()
	else
		local tween = TweenService:Create(
			main,
			TweenInfo.new(.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{Size = UDim2.fromOffset(0, 0)}
		)
		tween:Play()
		tween.Completed:Wait()
		main.Visible = false
	end

	busy = false
end

launcher.MouseButton1Click:Connect(function()
	-- Roblox fires MouseButton1Click after mouse-up even if the pointer
	-- moved slightly. Only suppress the action when our drag threshold
	-- was actually crossed.
	if launcherDidDrag then
		launcherDidDrag = false
		return
	end
	toggle()
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.LeftControl then
		toggle()
	end
end)

