-- Helper: get humanoid safely
local function getHumanoid()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChildOfClass("Humanoid")
end

-- Row layout tracker
local PC_ROW_START = 54   -- y inside playerCfgCard after the header
local PC_ROW_STEP  = 48   -- gap between rows
local pcRowCount   = 0

local function nextY()
	local y = PC_ROW_START + pcRowCount * PC_ROW_STEP
	pcRowCount += 1
	return y
end

