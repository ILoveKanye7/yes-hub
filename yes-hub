local function setOpacity(x)
	local left  = opTrack.AbsolutePosition.X
	local width = opTrack.AbsoluteSize.X
	local ratio = math.clamp((x - left) / width, 0, 1)
	-- snap to 5% steps
	ratio = math.floor(ratio * 20 + .5) / 20
	bgOpacity = ratio
	main.BackgroundTransparency = 1 - bgOpacity
	opFill.Size = UDim2.fromScale(ratio, 1)
	opKnob.Position = UDim2.new(ratio, 0, .5, 0)
	opValueLbl.Text = tostring(math.floor(ratio * 100 + .5)) .. "%"
end

opTrack.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		opDragging = true
		setOpacity(i.Position.X)
	end
end)
opFill.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		opDragging = true
		setOpacity(i.Position.X)
	end
end)
opKnob.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		opDragging = true
		setOpacity(i.Position.X)
	end
end)

