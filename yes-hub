------------------------------------------------------------------------
-- SINGLE InputChanged / InputEnded — handles both drag and opacity
------------------------------------------------------------------------
local DRAG_THRESH = 6

-- Main window drag state
local mainDown, mainDragging = false, false
local mainDragOrigin, mainStartPos

-- Launcher drag state
local lDown, lDragging, lDidDrag = false, false, false
local lDragOrigin, lStartPos

main.InputBegan:Connect(function(i)
	if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	local relY = i.Position.Y - main.AbsolutePosition.Y
	if relY <= 73 then
		mainDown        = true
		mainDragging    = false
		mainDragOrigin  = i.Position
		mainStartPos    = main.Position
	end
end)

launcher.InputBegan:Connect(function(i)
	if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	lDown       = true
	lDragging   = false
	lDidDrag    = false
	lDragOrigin = i.Position
	lStartPos   = launcher.Position
end)

UserInputService.InputChanged:Connect(function(i)
	if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end

	-- opacity slider
	if opDragging then setOpacity(i.Position.X) end

	-- main drag
	if mainDown then
		local d = i.Position - mainDragOrigin
		if not mainDragging and d.Magnitude >= DRAG_THRESH then mainDragging = true end
		if mainDragging then
			main.Position = UDim2.new(
				mainStartPos.X.Scale,  mainStartPos.X.Offset + d.X,
				mainStartPos.Y.Scale,  mainStartPos.Y.Offset + d.Y
			)
		end
	end

	-- launcher drag
	if lDown then
		local d = i.Position - lDragOrigin
		if not lDragging and d.Magnitude >= DRAG_THRESH then
			lDragging = true
			lDidDrag  = true
		end
		if lDragging then
			launcher.Position = UDim2.new(
				lStartPos.X.Scale,  lStartPos.X.Offset + d.X,
				lStartPos.Y.Scale,  lStartPos.Y.Offset + d.Y
			)
		end
	end
end)

UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	mainDown    = false
	mainDragging = false
	lDown       = false
	lDragging   = false
	opDragging  = false
end)

------------------------------------------------------------------------
-- OPEN / CLOSE TOGGLE
------------------------------------------------------------------------
local function toggle()
	if busy then return end
	busy   = true
	opened = not opened
	playClick()

	if opened then
		main.Visible = true
		main.Size    = UDim2.fromOffset(0, 0)
		local tw = TweenService:Create(main,
			TweenInfo.new(.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Size = UDim2.fromOffset(720, 430)}
		)
		tw:Play(); tw.Completed:Wait()
	else
		local tw = TweenService:Create(main,
			TweenInfo.new(.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{Size = UDim2.fromOffset(0, 0)}
		)
		tw:Play(); tw.Completed:Wait()
		main.Visible = false
	end

	busy = false
end

launcher.MouseButton1Click:Connect(function()
	if lDidDrag then lDidDrag = false return end
	toggle()
end)

UserInputService.InputBegan:Connect(function(i, processed)
	if processed then return end
	if i.KeyCode == Enum.KeyCode.LeftControl then toggle() end
end)

-- Initial state
main.Visible    = false
launcher.Visible = true
