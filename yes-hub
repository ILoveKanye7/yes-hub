------------------------------------------------------------------------
-- HELPERS
------------------------------------------------------------------------
local function corner(obj, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px)
	c.Parent = obj
end

local function outline(obj)
	local s = Instance.new("UIStroke")
	s.Color        = T.BORDER
	s.Thickness    = 1
	s.Transparency = 0.25
	s.Parent       = obj
end

local function mkLabel(parent, str, sz, font)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text           = str
	t.TextColor3     = T.WHITE
	t.TextSize       = sz
	t.Font           = font or Enum.Font.GothamBold
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Parent         = parent
	return t
end

local function mkButton(parent, str)
	local b = Instance.new("TextButton")
	b.BackgroundColor3  = T.BUTTON
	b.BorderSizePixel   = 0
	b.Text              = str
	b.TextColor3        = T.WHITE
	b.TextSize          = 12
	b.Font              = Enum.Font.GothamBold
	b.AutoButtonColor   = false
	b.TextXAlignment    = Enum.TextXAlignment.Center
	b.Parent            = parent
	corner(b, 8)
	outline(b)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.HOVER}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.BUTTON}):Play()
	end)
	return b
end

local function playClick()
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://12221967"
	s.Volume  = 1
	s.Parent  = SoundService
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
end

local function fmtTime(secs)
	secs = math.floor(secs)
	local h = math.floor(secs / 3600)
	local m = math.floor((secs % 3600) % 60 / 60)  -- kept simple
	local s2= secs % 60
	m = math.floor((secs % 3600) / 60)
	if h > 0 then return string.format("%02dh %02dm %02ds", h, m, s2) end
	return string.format("%02dm %02ds", m, s2)
end

------------------------------------------------------------------------
-- SHARED ROW FACTORIES
-- makeToggle  → returns { get() }
-- makeNumRow  → returns { get(), set(v) }
-- Both accept (parent, label, yOff, ...) and build inside parent.
------------------------------------------------------------------------
local ROW_H   = 40
local ROW_PAD = 12   -- left/right inset inside the card

local function makeToggle(parent, label, yOff, initial, onChange)
	local row = Instance.new("Frame")
	row.Size             = UDim2.new(1, -ROW_PAD * 2, 0, ROW_H)
	row.Position         = UDim2.fromOffset(ROW_PAD, yOff)
	row.BackgroundColor3 = T.BUTTON
	row.BorderSizePixel  = 0
	row.Parent           = parent
	corner(row, 8)

	local lbl = mkLabel(row, label, 11)
	lbl.Size     = UDim2.new(1, -80, 1, 0)
	lbl.Position = UDim2.fromOffset(12, 0)

	local pill = Instance.new("TextButton")
	pill.Size             = UDim2.fromOffset(46, 24)
	pill.Position         = UDim2.new(1, -58, .5, -12)
	pill.BackgroundColor3 = initial and T.ON or T.OFF
	pill.BorderSizePixel  = 0
	pill.Text             = ""
	pill.AutoButtonColor  = false
	pill.Parent           = row
	corner(pill, 12)

	local knob = Instance.new("Frame")
	knob.Size             = UDim2.fromOffset(18, 18)
	knob.Position         = initial and UDim2.new(1, -21, .5, -9) or UDim2.new(0, 3, .5, -9)
	knob.BackgroundColor3 = T.WHITE
	knob.BorderSizePixel  = 0
	knob.Parent           = pill
	corner(knob, 9)

	local state = initial

	pill.MouseButton1Click:Connect(function()
		state = not state
		TweenService:Create(pill, TweenInfo.new(.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			BackgroundColor3 = state and T.ON or T.OFF
		}):Play()
		TweenService:Create(knob, TweenInfo.new(.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position = state and UDim2.new(1, -21, .5, -9) or UDim2.new(0, 3, .5, -9)
		}):Play()
		playClick()
		if onChange then onChange(state) end
	end)

	return { get = function() return state end }
end

-- makeNumRow: a row with label on left, [−] [box] [+] on right
-- params: parent, label, yOff, default, min, max, step
-- returns { get(), set(v) }
local NUM_BTN_W = 28
local NUM_BOX_W = 52
local NUM_GAP   = 4
local NUM_MAR   = 12

local function makeNumRow(parent, label, yOff, default, minVal, maxVal, step, onChange)
	local row = Instance.new("Frame")
	row.Size             = UDim2.new(1, -ROW_PAD * 2, 0, ROW_H)
	row.Position         = UDim2.fromOffset(ROW_PAD, yOff)
	row.BackgroundColor3 = T.BUTTON
	row.BorderSizePixel  = 0
	row.Parent           = parent
	corner(row, 8)

	local lbl = mkLabel(row, label, 11)
	lbl.Size     = UDim2.new(1, -180, 1, 0)
	lbl.Position = UDim2.fromOffset(12, 0)

	-- + button (rightmost)
	local bPlus = Instance.new("TextButton")
	bPlus.Size             = UDim2.fromOffset(NUM_BTN_W, ROW_H - 12)
	bPlus.Position         = UDim2.new(1, -NUM_MAR - NUM_BTN_W, .5, -(ROW_H - 12) / 2)
	bPlus.BackgroundColor3 = T.HOVER
	bPlus.BorderSizePixel  = 0
	bPlus.Text             = "+"
	bPlus.TextColor3       = T.WHITE
	bPlus.TextSize         = 14
	bPlus.Font             = Enum.Font.GothamBold
	bPlus.AutoButtonColor  = false
	bPlus.Parent           = row
	corner(bPlus, 6)
	outline(bPlus)

	-- text box (middle)
	local box = Instance.new("TextBox")
	box.Size             = UDim2.fromOffset(NUM_BOX_W, ROW_H - 12)
	box.Position         = UDim2.new(1, -NUM_MAR - NUM_BTN_W - NUM_GAP - NUM_BOX_W, .5, -(ROW_H - 12) / 2)
	box.BackgroundColor3 = T.BG
	box.BorderSizePixel  = 0
	box.Text             = tostring(default)
	box.TextColor3       = T.WHITE
	box.TextSize         = 12
	box.Font             = Enum.Font.GothamBold
	box.TextXAlignment   = Enum.TextXAlignment.Center
	box.ClearTextOnFocus = false
	box.Parent           = row
	corner(box, 6)
	outline(box)

	-- − button (left of box)
	local bMinus = Instance.new("TextButton")
	bMinus.Size             = UDim2.fromOffset(NUM_BTN_W, ROW_H - 12)
	bMinus.Position         = UDim2.new(1, -NUM_MAR - NUM_BTN_W - NUM_GAP - NUM_BOX_W - NUM_GAP - NUM_BTN_W, .5, -(ROW_H - 12) / 2)
	bMinus.BackgroundColor3 = T.HOVER
	bMinus.BorderSizePixel  = 0
	bMinus.Text             = "−"
	bMinus.TextColor3       = T.WHITE
	bMinus.TextSize         = 14
	bMinus.Font             = Enum.Font.GothamBold
	bMinus.AutoButtonColor  = false
	bMinus.Parent           = row
	corner(bMinus, 6)
	outline(bMinus)

	-- hover tints
	for _, b in ipairs({bPlus, bMinus}) do
		b.MouseEnter:Connect(function()
			TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.BORDER}):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(b, TweenInfo.new(.1), {BackgroundColor3 = T.HOVER}):Play()
		end)
	end

	local value = default

	local function apply(v)
		v = tonumber(v) or value
		v = math.clamp(math.floor(v / step + .5) * step, minVal, maxVal)
		value = v
		box.Text = tostring(value)
		if onChange then onChange(value) end
	end

	bPlus.MouseButton1Click:Connect(function()  playClick() apply(value + step) end)
	bMinus.MouseButton1Click:Connect(function() playClick() apply(value - step) end)
	box.FocusLost:Connect(function() apply(box.Text) end)

	return {
		get = function() return value end,
		set = function(v) apply(v) end,
	}
end

