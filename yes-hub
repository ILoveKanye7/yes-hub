-- Respawn handling: re-apply active player settings on character load
------------------------------------------------------------------------
player.CharacterAdded:Connect(function(char)
	-- Give the character a frame to fully load
	task.wait(0.1)

	local h = char:WaitForChild("Humanoid", 5)
	if not h then return end

	-- Re-apply numeric values
	h.WalkSpeed = wsRow.get()
	h.JumpPower = jpRow.get()
	pcall(function() h.JumpHeight = jhRow.get() end)
	pcall(function() h.HipHeight  = hhRow.get() end)

	-- Re-apply noclip connection
	if noclipActive then
		if noclipConn then noclipConn:Disconnect() end
		noclipConn = RunService.Stepped:Connect(function()
			local c = player.Character
			if not c then return end
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end)
	end

	-- Gravity persists on workspace, no action needed
end)

