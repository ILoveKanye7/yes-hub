local PAGES = {
	Home     = pageHome,
	Ring     = pageRing,
	Modules  = pageModules,
	Settings = pageSettings,
}
local NAV_BTNS = {
	Home     = btnHome,
	Ring     = btnRing,
	Modules  = btnModules,
	Settings = btnSettings,
}

local function showPage(name)
	for k, pg in pairs(PAGES)    do pg.Visible = (k == name) end
	for k, nb in pairs(NAV_BTNS) do
		-- bypass the hover tween — set directly
		nb.BackgroundColor3 = (k == name) and T.HOVER or T.BUTTON
	end
end

btnHome.MouseButton1Click:Connect(function()     playClick() showPage("Home") end)
btnRing.MouseButton1Click:Connect(function()     playClick() showPage("Ring") end)
btnModules.MouseButton1Click:Connect(function()  playClick() showPage("Modules") end)
btnSettings.MouseButton1Click:Connect(function() playClick() showPage("Settings") end)

